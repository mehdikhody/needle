{{ if .Data -}}
local MK = ni.utils.require("{{ .Data }}")
if not MK then
    print("|cffff0000{{ .Data }} is missing|r")
    return
end

{{ end -}}
local QUEUE = {
{{- range .Profile.Rotation }}
    "{{ . }}",
{{- end }}
}

local ABILITIES = {
{{- range .Abilities }}
    ["{{ .ID }}"] = function()
        {{ if $.Config.Print -}}
        print("{{ .ID }}")
        {{ end -}}
        {{ indent .Lua 8 }}
    end,
{{- end }}
}

{{ if .Data -}}
local function queue()
    if MK.Blocked and MK.Blocked() then
        return {}
    end
    if MK.ALLOW and not MK.ALLOW[UnitName("player")] then
        return {}
    end
    return QUEUE
end

ni.bootstrap.profile("{{ .ID }}", queue, ABILITIES)
{{- else -}}
ni.bootstrap.profile("{{ .ID }}", QUEUE, ABILITIES)
{{- end }}