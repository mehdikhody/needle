local QUEUE = {
{{- range .Profile.Rotation }}
    "{{ . }}",
{{- end }}
}

local ABILITIES = {
{{- range .Abilities }}
    ["{{ .ID }}"] = function()
        {{ if $.Config.Print -}}
        print("{{ .ID }}")
        {{ end -}}
        {{ indent .Lua 8 }}
    end,
{{- end }}
}

ni.bootstrap.profile("{{ .ID }}", QUEUE, ABILITIES)