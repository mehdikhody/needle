local function test()
    {{ indent .Ability.Lua 4 }}
end

{{ if .Config.Debug -}}
local function execute()
    local status, output = pcall(test)
    if status then
        if output then
            {{ if and (ne .Ability.SpellId "") (ne .Ability.Target "") -}}
            ni.spell.cast({{ .Ability.SpellId }}, "{{ .Ability.Target }}")
            {{ else if ne .Ability.SpellId "" -}}
            ni.spell.cast({{ .Ability.SpellId }})
            {{ end -}}
            return true
        end
    else
        print("{{ .Ability.ID }}", output)
    end

    return false
end
{{ else -}}
local function execute()
    if test() then
        {{ if and (ne .Ability.SpellId "") (ne .Ability.Target "") -}}
        ni.spell.cast({{ .Ability.SpellId }}, "{{ .Ability.Target }}")
        {{ else if ne .Ability.SpellId "" -}}
        ni.spell.cast({{ .Ability.SpellId }})
        {{ end -}}
        return true
    end

    return false
end
{{ end }}
{{ if and (ne .Ability.SpellId "") (ne .Ability.Target "") -}}
if
    UnitExists("{{ .Ability.Target }}")
    and IsUsableSpell(GetSpellInfo({{ .Ability.SpellId }})) == 1
    and ni.spell.available({{ .Ability.SpellId }})
then
    if UnitIsUnit("player", "{{ .Ability.Target }}") or UnitIsFriend("player", "{{ .Ability.Target }}") then
        if ni.spell.valid("{{ .Ability.Target }}", {{ .Ability.SpellId }}, {{ .Ability.Facing }}, {{ .Ability.Los }}, true) then
            if execute() then
                return true
            end
        end
    else
        if
            ni.unit.canattack("player", "{{ .Ability.Target }}")
            and ni.spell.valid("{{ .Ability.Target }}", {{ .Ability.SpellId }}, {{ .Ability.Facing }}, {{ .Ability.Los }})
        then
            if execute() then
                return true
            end
        end
    end
end
{{ else if ne .Ability.SpellId "" -}}
if
    IsUsableSpell(GetSpellInfo({{ .Ability.SpellId }})) == 1
    and ni.spell.available({{ .Ability.SpellId }})
then
    if execute() then
        return true
    end
end
{{ else -}}
if execute() then
    return true
end
{{ end -}}